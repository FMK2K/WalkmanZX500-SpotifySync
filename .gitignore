# =====================================================================
#  SpotifyTunerMK12 — .gitignore
#  Tracks: source (src/, tests/), docs, planning files, project config.
#  Ignores: all regenerable runtime state, logs, caches, data exports,
#           heavy reference material, and the pre-reorg flat-layout debris.
# =====================================================================

# ── Python ───────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.ipynb_checkpoints/

# ── Virtual envs / secrets ───────────────────────────────────────────
.venv/
.venv*/
venv/
venv*/
env/
.env
.env.*

# ── Auth tokens / credentials caches — NEVER commit ──────────────────
.spotify_auth_cache
.spotify_metadata_cache.json
.tidal_session.json
.tidal_album_cache.json
.streaming_scores_cache.json
*_auth_cache*
*.session.json

# ── Local caches / lock / db / append-log state (dot-prefixed at root) ─
.*cache*
.*_cache*
.device_io.lock
.device_library_cache.json
.metadata_cache.json
.mk*.jsonl
.mk*.db
*.jsonl
*.lock
*.db
*.db-journal

# ── IDE / OS ─────────────────────────────────────────────────────────
.vscode/
.idea/
.DS_Store
Thumbs.db
.claude/scheduled_tasks.lock
.claude/settings.local.json

# ── Post-reorg tree: whole dirs of non-source material ───────────────
state/
logs/
data/
archive/
outputs/reports/*.html
outputs/reports/*.png

# ── Logs & large text dumps (flat layout + anywhere) ─────────────────
*.log
*.txt
!requirements.txt
!CLAUDE.md
!AGENTS.md
startup_error.txt

# ── Runtime state JSON (regenerated by the tools — never source) ─────
*_state.json
*_report.json
*_categorized.json
*_pending.json
.acoustid_cache.json
.album_meta_cache.json
.genre_cache.json
.dedup_log.json
.dedup_plan.json
.audit_state.json
.deep_clean_progress.json
walkman_snapshot.json
walkman_tag_snapshot.json
walkman_inventory.tsv
streaming_scores.json
streaming_history*.json
favorites_playlists_plan*.json
fav_upgrade_restar.json
mislabel_restar.json
restar_merged.json
corrupt_redownload.json
artist_completeness_report.json
artist_completeness_actionable.json
catalog_*.json
cover_fill_state.json
year_backfill_state.json
album_normalize_tagfix_state.json
duration_verify_*.json
incompleteness_report.json
genre_graph.json
genre_graph.png
*_completeness_report.json
*.bak
*.bak-*
*.bak_*
*_bak
*.v3_bak
*.mk14_bak
*.orig
*.rej

# ── Heavy binaries / reference material ─────────────────────────────
*.zip
*.exe
*.dll
*.pdb
*.png
*.jpg
*.xml
*.pid
*.tsv
*.ps1
*.sh
!walkman_inventory.sh
fpcalc*
tools/
Spotify Account Data/
Spotify Extended Streaming History/
walkman_HiRes*/
download/
MANIFEST.json
*_MANIFEST.json
genre_overrides.json
internal_music_manifest.json
manual_mislabel_findings.json
mislabel_delete_list.json
mk35_default_policy.json
mk37_2_architecture.json
mk37_2_acceptance.html
mk36_agent_review.html
reorg_rollback.json
reorg_rollback*.json
restar_*.json
spotify_tuner_comprehensive_doc.json
spotifytuner_graph.json
codebase_updated.json
burnaboy_expected_discography.json
favplaylist_apply_state*.json
desktop.ini

# ── Explicitly TRACK these even though patterns above might catch them ─
!.gitignore
!.gitattributes
!README.md
!docs/**/*.md
!task_plan.md
!progress.md
!findings.md
